PORT=5000
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/smartrail

# Secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Optional. How long a login lasts (default 8h).
# JWT_EXPIRES_IN=8h
# Optional. Seconds without a GPS update before a train shows "no signal" (default 300).
# TRAIN_SIGNAL_TIMEOUT_SECONDS=300

# PayHere (Sri Lanka, LKR). Sandbox merchant credentials from sandbox.payhere.lk (Integrations).
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# Optional: App ID / App Secret from Settings > API Keys (Payment Retrieval API). Lets the server confirm
# payments by asking PayHere, so top-ups complete even without a public notify URL.
# PAYHERE_APP_ID=
# PAYHERE_APP_SECRET=
# Sandbox unless set to false.
# PAYHERE_SANDBOX=true
# Public URL of this backend, so PayHere can post payment notifications (e.g. an ngrok URL).
# PAYHERE_NOTIFY_URL=https://<your-tunnel>/api/payhere/notify
# Where PayHere sends the Passenger back (the frontend origin). When testing on a phone, use the
# public HTTPS origin of the frontend (e.g. the ngrok tunnel in front of `npm run preview`).
# FRONTEND_URL=http://localhost:5173
# Top-up limits in whole rupees (defaults 500 and 50000).
# TOPUP_MIN=500
# TOPUP_MAX=50000
# Minutes an unpaid top-up stays pending (default 30, minimum 30).
# TOPUP_PENDING_MINUTES=30
# Set true to re-enable the legacy no-payment top-up for demos.
# ALLOW_DEMO_TOPUP=false
